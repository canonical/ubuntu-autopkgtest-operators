{
  "title": "Autopkgtest Website (Apache)",
  "description": "Apache metrics for the ubuntu-autopkgtest-website charm, from prometheus-apache-exporter scraping mod_status.",
  "tags": ["autopkgtest"],
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Apache requests/sec",
      "description": "Derived from mod_status via prometheus-apache-exporter.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "hideFrom": {"legend": false, "tooltip": false, "viz": false}
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
          "expr": "rate(apache_accesses_total{}[$__rate_interval])",
          "legendFormat": "requests/sec",
          "interval": "5m"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Apache workers busy / idle",
      "description": "",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "hideFrom": {"legend": false, "tooltip": false, "viz": false}
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
          "expr": "apache_workers{}",
          "legendFormat": "{{state}}",
          "interval": "5m"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Apache bytes sent/sec",
      "description": "",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "hideFrom": {"legend": false, "tooltip": false, "viz": false}
          },
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
          "expr": "rate(apache_sent_kilobytes_total{}[$__rate_interval]) * 1024",
          "legendFormat": "bytes/sec",
          "interval": "5m"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Apache CPU load",
      "description": "Percentage of CPU used by Apache workers.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "hideFrom": {"legend": false, "tooltip": false, "viz": false}
          },
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
          "expr": "apache_cpuload{}",
          "legendFormat": "cpu load",
          "interval": "5m"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Apache up",
      "description": "Whether prometheus-apache-exporter could successfully scrape mod_status.",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "hideFrom": {"legend": false, "tooltip": false, "viz": false}
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "${prometheusds}"},
          "expr": "apache_up{}",
          "legendFormat": "up",
          "interval": "5m"
        }
      ]
    }
  ],
  "links": []
}
